{
	"compilerOptions": {
		"target": "ES6",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "index.ts"],
	"exclude": [
		"node_modules",
		"src/models/admin.model.ts",
		"src/config/settings.ts",
		"src/controllers/admin.controller.ts",
		"src/middlewares/auth.middleware.ts"
	]
}